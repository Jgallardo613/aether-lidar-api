{
  "swagger": "2.0",
  "info": {
    "title": "Aether Apex LIDAR API",
    "description": "CRUD API for soldier LIDAR scan detection and operator status tracking. POST, PUT, and DELETE routes require GitHub OAuth authentication.",
    "version": "1.0.0"
  },
  "host": "aether-lidar-api.onrender.com",
  "basePath": "/",
  "schemes": [
    "https"
  ],
  "securityDefinitions": {
    "GitHubOAuth": {
      "type": "oauth2",
      "authorizationUrl": "https://aether-lidar-api.onrender.com/auth/github",
      "flow": "implicit",
      "scopes": {
        "read:user": "Read user profile"
      }
    }
  },
  "paths": {
    "/auth/github": {
      "get": {
        "description": "Redirects to GitHub for OAuth login",
        "responses": {
          "302": {
            "description": "Redirect to GitHub"
          }
        }
      }
    },
    "/auth/github/callback": {
      "get": {
        "description": "GitHub OAuth callback URL — handles login redirect",
        "responses": {
          "302": {
            "description": "Redirect after login"
          }
        }
      }
    },
    "/auth/logout": {
      "get": {
        "description": "Logs the current user out",
        "responses": {
          "302": {
            "description": "Redirect after logout"
          }
        }
      }
    },
    "/scans/": {
      "get": {
        "description": "Get all scans — public route, no login required",
        "responses": {
          "200": {
            "description": "OK"
          },
          "500": {
            "description": "Internal Server Error"
          }
        }
      },
      "post": {
        "description": "Create a new scan — requires GitHub OAuth login",
        "security": [{ "GitHubOAuth": ["read:user"] }],
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "type": "object",
              "properties": {
                "scan_id": { "type": "number" },
                "soldier_id": { "type": "number" },
                "object_type": { "type": "string" },
                "distance_m": { "type": "number" },
                "bearing": { "type": "number" },
                "confidence": { "type": "number" },
                "hazard_level": { "type": "string" }
              }
            }
          }
        ],
        "responses": {
          "201": {
            "description": "Created"
          },
          "400": {
            "description": "Bad Request"
          },
          "401": {
            "description": "Unauthorized — login required"
          },
          "500": {
            "description": "Internal Server Error"
          }
        }
      }
    },
    "/scans/{id}": {
      "get": {
        "description": "Get a scan by ID — public route, no login required",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "type": "string"
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          },
          "404": {
            "description": "Not Found"
          },
          "500": {
            "description": "Internal Server Error"
          }
        }
      },
      "put": {
        "description": "Update a scan by ID — requires GitHub OAuth login",
        "security": [{ "GitHubOAuth": ["read:user"] }],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "type": "string"
          },
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "type": "object",
              "properties": {
                "scan_id": { "type": "number" },
                "soldier_id": { "type": "number" },
                "object_type": { "type": "string" },
                "distance_m": { "type": "number" },
                "bearing": { "type": "number" },
                "confidence": { "type": "number" },
                "hazard_level": { "type": "string" }
              }
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          },
          "400": {
            "description": "Bad Request"
          },
          "401": {
            "description": "Unauthorized — login required"
          },
          "404": {
            "description": "Not Found"
          },
          "500": {
            "description": "Internal Server Error"
          }
        }
      },
      "delete": {
        "description": "Delete a scan by ID — requires GitHub OAuth login",
        "security": [{ "GitHubOAuth": ["read:user"] }],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "type": "string"
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          },
          "401": {
            "description": "Unauthorized — login required"
          },
          "404": {
            "description": "Not Found"
          },
          "500": {
            "description": "Internal Server Error"
          }
        }
      }
    },
    "/operators/": {
      "get": {
        "description": "Get all operators — public route, no login required",
        "responses": {
          "200": {
            "description": "OK"
          },
          "500": {
            "description": "Internal Server Error"
          }
        }
      },
      "post": {
        "description": "Create a new operator — requires GitHub OAuth login",
        "security": [{ "GitHubOAuth": ["read:user"] }],
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "type": "object",
              "properties": {
                "soldier_id": { "type": "number" },
                "callsign": { "type": "string" },
                "suit_status": { "type": "string" },
                "current_location": { "type": "string" },
                "active_scan_range_m": { "type": "number" }
              }
            }
          }
        ],
        "responses": {
          "201": {
            "description": "Created"
          },
          "400": {
            "description": "Bad Request"
          },
          "401": {
            "description": "Unauthorized — login required"
          },
          "500": {
            "description": "Internal Server Error"
          }
        }
      }
    },
    "/operators/{id}": {
      "get": {
        "description": "Get an operator by ID — public route, no login required",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "type": "string"
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          },
          "404": {
            "description": "Not Found"
          },
          "500": {
            "description": "Internal Server Error"
          }
        }
      },
      "put": {
        "description": "Update an operator by ID — requires GitHub OAuth login",
        "security": [{ "GitHubOAuth": ["read:user"] }],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "type": "string"
          },
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "type": "object",
              "properties": {
                "soldier_id": { "type": "number" },
                "callsign": { "type": "string" },
                "suit_status": { "type": "string" },
                "current_location": { "type": "string" },
                "active_scan_range_m": { "type": "number" }
              }
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          },
          "400": {
            "description": "Bad Request"
          },
          "401": {
            "description": "Unauthorized — login required"
          },
          "404": {
            "description": "Not Found"
          },
          "500": {
            "description": "Internal Server Error"
          }
        }
      },
      "delete": {
        "description": "Delete an operator by ID — requires GitHub OAuth login",
        "security": [{ "GitHubOAuth": ["read:user"] }],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "type": "string"
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          },
          "401": {
            "description": "Unauthorized — login required"
          },
          "404": {
            "description": "Not Found"
          },
          "500": {
            "description": "Internal Server Error"
          }
        }
      }
    }
  }
}